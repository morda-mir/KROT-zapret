<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>KROT.Service</AssemblyName>
    <RootNamespace>KROT.Service</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\KROT.Core\KROT.Core.csproj" />
    <ProjectReference Include="..\KROT.Diagnostics\KROT.Diagnostics.csproj" />
    <ProjectReference Include="..\KROT.Infrastructure\KROT.Infrastructure.csproj" />
    <ProjectReference Include="..\KROT.Zapret\KROT.Zapret.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\third_party\zapret\**\*.*"
             Exclude="..\..\third_party\zapret\zapret2-v1.0.2\**\*.*;..\..\third_party\zapret\zapret2-v1.0.3\**\*.*"
             Link="runtime\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RemoveUnusedZapret2Runtime" AfterTargets="Build">
    <RemoveDir Directories="$(TargetDir)runtime\zapret2-v1.0.2;$(TargetDir)runtime\zapret2-v1.0.3" />
  </Target>
</Project>
