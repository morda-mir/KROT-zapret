<Window x:Class="KROT.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KROT.App.Controls"
        xmlns:vm="clr-namespace:KROT.App.ViewModels"
        Title="{Binding Title}"
        Width="460"
        Height="450"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
  <Border Background="{StaticResource WindowBrush}"
          BorderBrush="#303840"
          BorderThickness="1"
          CornerRadius="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="60" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Title}"
                   Foreground="{StaticResource TextBrush}"
                   FontWeight="SemiBold"
                   FontSize="22"
                   Margin="22,0,0,0"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,10,10,0" VerticalAlignment="Top">
          <Button Content="i"
                  Width="38"
                  Height="34"
                  Padding="0"
                  FontWeight="Bold"
                  Command="{Binding ToggleHelpCommand}" />
          <Button Content="—" Width="38" Height="34" Padding="0" Margin="4,0,0,0" Click="Minimize_OnClick" />
          <Button Content="×" Width="38" Height="34" Padding="0" Margin="4,0,0,0" Click="Close_OnClick" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="22,4,22,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="92" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="82" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <controls:KrotMascot Width="128"
                               Height="87"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center" />

          <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock Text="{Binding AutoStartText}"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       HorizontalAlignment="Right" />
            <CheckBox Style="{StaticResource ServiceCheckBox}"
                      IsChecked="{Binding AutoStart}"
                      HorizontalAlignment="Right"
                      Margin="0,8,0,0"
                      AutomationProperties.Name="{Binding AutoStartText}" />
          </StackPanel>
        </Grid>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Services}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ServiceItemViewModel}">
              <Border Background="{StaticResource PanelBrush}"
                      CornerRadius="12"
                      Height="60"
                      Margin="0,0,0,6">
                <Grid Margin="14,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                  </Grid.ColumnDefinitions>

                  <Border Width="42" Height="42" CornerRadius="12" Background="#111519">
                    <Grid>
                      <Image Source="{Binding IconSource}"
                             Width="34"
                             Height="34"
                             Stretch="Uniform"
                             RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                          <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IconSource}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Image.Style>
                      </Image>
                      <TextBlock Text="{Binding IconGlyph}"
                                 Foreground="{StaticResource TextBrush}"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IconSource}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                  </Border>

                  <ItemsControl Grid.Column="1" ItemsSource="{Binding Channels}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Width="46"
                              Height="42"
                              ToolTip="{Binding Tooltip}"
                              SnapsToDevicePixels="True">
                          <Ellipse Width="34"
                                   Height="34"
                                   Fill="{Binding State, Converter={StaticResource StateBrush}}"
                                   Opacity="0.16" />
                          <Viewbox Width="23"
                                   Height="23"
                                   Stretch="Uniform"
                                   SnapsToDevicePixels="True">
                            <Path Width="24"
                                  Height="24"
                                  Data="{Binding GeometryData}"
                                  Fill="Transparent"
                                  Stroke="{Binding State, Converter={StaticResource StateBrush}}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform"
                                  SnapsToDevicePixels="True" />
                          </Viewbox>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <CheckBox Grid.Column="2"
                            Style="{StaticResource ServiceCheckBox}"
                            IsChecked="{Binding IsSelected}"
                            IsEnabled="{Binding CanEdit}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding Id}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button Width="190"
                  Height="46"
                  FontSize="15"
                  FontWeight="SemiBold"
                  Background="#285E48"
                  Content="{Binding PrimaryActionText}"
                  Command="{Binding ToggleRuntimeCommand}" />
        </StackPanel>
      </Grid>

      <Border Grid.RowSpan="2"
              Width="310"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,54,14,0"
              Padding="16"
              CornerRadius="14"
              Background="#242B31"
              BorderBrush="#364049"
              BorderThickness="1"
              Panel.ZIndex="10"
              Visibility="{Binding IsHelpOpen, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="{Binding AboutText}"
                     Foreground="{StaticResource TextBrush}"
                     FontSize="17"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding VersionText}"
                     Foreground="{StaticResource MutedTextBrush}"
                     Margin="0,3,0,0" />
          <Separator Margin="0,12" Background="#46515B" />
          <TextBlock Text="{Binding LanguageText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
          <StackPanel Orientation="Horizontal">
            <Button Content="RU" Width="58" Command="{Binding SetRussianCommand}" />
            <Button Content="EN" Width="58" Margin="6,0,0,0" Command="{Binding SetEnglishCommand}" />
            <TextBlock Text="{Binding CurrentLanguage}"
                       Foreground="{StaticResource AccentBrush}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />
          </StackPanel>
          <CheckBox Content="{Binding LogsText}"
                    Foreground="{StaticResource TextBrush}"
                    IsChecked="{Binding DetailedLogs}"
                    Margin="0,14,0,8" />
          <Button Content="{Binding ViewLogsText}" Click="OpenLogs_OnClick" HorizontalContentAlignment="Left" />
          <Button Command="{Binding OpenProjectRepositoryCommand}"
                  Margin="0,10,0,0"
                  HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <Image Source="pack://application:,,,/KROT;component/assets/services/github-dark-512px.png"
                     Width="22"
                     Height="22"
                     Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock Text="{Binding ProjectRepositoryText}"
                         VerticalAlignment="Center"
                         Margin="10,0,0,0" />
            </StackPanel>
          </Button>
          <Button Command="{Binding OpenZapretCommand}"
                  Margin="0,6,0,0"
                  HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <Image Source="pack://application:,,,/KROT;component/assets/services/github-dark-512px.png"
                     Width="22"
                     Height="22"
                     Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock Text="{Binding ZapretText}"
                         VerticalAlignment="Center"
                         Margin="10,0,0,0" />
            </StackPanel>
          </Button>
          <TextBlock Text="{Binding LicensesText}" Foreground="{StaticResource MutedTextBrush}" Margin="2,14,0,0" />
          <TextBlock Text="Zapret · MIT    WinDivert · LGPL-3.0/GPL-2.0"
                     Foreground="{StaticResource MutedTextBrush}"
                     FontSize="10"
                     Margin="2,4,0,0" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
