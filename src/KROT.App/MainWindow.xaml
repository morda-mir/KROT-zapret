<Window x:Class="KROT.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KROT.App.Controls"
        xmlns:vm="clr-namespace:KROT.App.ViewModels"
        Title="{Binding Title}"
        Width="400"
        Height="380"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
  <Border Background="{StaticResource WindowBrush}"
          BorderBrush="#303840"
          BorderThickness="1"
          CornerRadius="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Title}"
                   Foreground="{StaticResource TextBrush}"
                   FontWeight="SemiBold"
                   FontSize="20"
                   Margin="18,0,0,0"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,8,8,0" VerticalAlignment="Top">
          <Button Content="i"
                  Width="36"
                  Height="32"
                  Padding="0"
                  FontWeight="Bold"
                  Command="{Binding ToggleHelpCommand}" />
          <Button Content="—" Width="36" Height="32" Padding="0" Margin="4,0,0,0" Click="Minimize_OnClick" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="18,2,18,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="70" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <controls:KrotMascot Width="104"
                               Height="68"
                               IsSearching="{Binding HasBusyChannels}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center" />

          <Grid Grid.Column="1"
                Margin="-2,0,8,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Visibility="{Binding ExternalTunnelDetected, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Path Data="M 8,0 L 0,6 L 8,12 Z"
                  Fill="#F6D77A"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center" />
            <Border Grid.Column="1"
                    MaxWidth="108"
                    MinHeight="36"
                    Padding="9,5"
                    CornerRadius="10"
                    Background="#F6D77A"
                    BorderBrush="#D9B958"
                    BorderThickness="1">
              <TextBlock Text="{Binding VpnWarningText}"
                         Foreground="#252A2E"
                         FontSize="11"
                         FontWeight="SemiBold"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center" />
            </Border>
          </Grid>

          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Right"
                      Margin="0,0,12,0">
            <TextBlock Text="{Binding AutoStartText}"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       VerticalAlignment="Center" />
            <CheckBox Style="{StaticResource ServiceCheckBox}"
                      IsChecked="{Binding AutoStart}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="10,0,0,0"
                      AutomationProperties.Name="{Binding AutoStartText}" />
          </StackPanel>
        </Grid>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Services}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ServiceItemViewModel}">
              <Border Background="{StaticResource PanelBrush}"
                      CornerRadius="12"
                      Height="54"
                      Margin="0,0,0,6">
                <Grid Margin="12,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="36" />
                  </Grid.ColumnDefinitions>

                  <Border Width="38" Height="38" Background="Transparent">
                    <Grid>
                      <Image Source="{Binding IconSource}"
                             Width="32"
                             Height="32"
                             Stretch="Uniform"
                             RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                          <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IconSource}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Image.Style>
                      </Image>
                      <Viewbox Width="30"
                               Height="30"
                               Stretch="Uniform"
                               Visibility="{Binding HasVectorIcon, Converter={StaticResource BoolToVisibility}}">
                        <Path Width="24"
                              Height="24"
                              Data="{Binding IconGeometryData}"
                              Fill="Transparent"
                              Stroke="{StaticResource TextBrush}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform" />
                      </Viewbox>
                      <TextBlock Text="{Binding IconGlyph}"
                                 Foreground="{StaticResource TextBrush}"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IconSource}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding HasVectorIcon}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                  </Border>

                  <ItemsControl Grid.Column="1" ItemsSource="{Binding Channels}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Width="46"
                              Height="38"
                              ToolTip="{Binding Tooltip}"
                              SnapsToDevicePixels="True">
                          <Ellipse Width="30"
                                   Height="30"
                                   RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                              <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Style>
                              <Style TargetType="Ellipse">
                                <Setter Property="Fill"
                                        Value="{Binding State, Converter={StaticResource StateBrush}}" />
                                <Setter Property="Opacity" Value="0.16" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Fill"
                                            Value="{StaticResource WarningBrush}" />
                                    <DataTrigger.EnterActions>
                                      <BeginStoryboard x:Name="BusyPulse">
                                        <Storyboard RepeatBehavior="Forever"
                                                    AutoReverse="True">
                                          <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                           From="0.12"
                                                           To="0.48"
                                                           Duration="0:0:0.65" />
                                          <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                           From="0.86"
                                                           To="1.08"
                                                           Duration="0:0:0.65" />
                                          <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                           From="0.86"
                                                           To="1.08"
                                                           Duration="0:0:0.65" />
                                        </Storyboard>
                                      </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                      <StopStoryboard BeginStoryboardName="BusyPulse" />
                                    </DataTrigger.ExitActions>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Ellipse.Style>
                          </Ellipse>
                          <Viewbox Width="21"
                                   Height="21"
                                   Stretch="Uniform"
                                   SnapsToDevicePixels="True">
                            <Path Width="24"
                                  Height="24"
                                  Data="{Binding GeometryData}"
                                  Fill="Transparent"
                                  Stroke="{Binding State, Converter={StaticResource StateBrush}}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform"
                                  SnapsToDevicePixels="True" />
                          </Viewbox>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Button Grid.Column="2"
                          Width="24"
                          Height="24"
                          Padding="4"
                          Margin="0"
                          Background="Transparent"
                          BorderThickness="0"
                          Command="{Binding RefreshCommand}"
                          ToolTip="{Binding RefreshTooltip}"
                          AutomationProperties.Name="{Binding RefreshTooltip}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          FocusVisualStyle="{x:Null}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Visibility" Value="Hidden" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CanRefresh}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                    <Viewbox Width="16" Height="16" Stretch="Uniform">
                      <Path Data="{Binding ActionGeometryData}"
                            Fill="Transparent"
                            Stroke="#8B959D"
                            StrokeThickness="1.8"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round" />
                    </Viewbox>
                  </Button>

                  <CheckBox Grid.Column="3"
                            Style="{StaticResource ServiceCheckBox}"
                            IsChecked="{Binding IsSelected}"
                            IsEnabled="{Binding CanEdit}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding Id}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="2" VerticalAlignment="Center">
          <Button Width="176"
                  Height="42"
                  HorizontalAlignment="Center"
                  FontSize="15"
                  FontWeight="SemiBold"
                  Background="#285E48"
                  Content="{Binding PrimaryActionText}"
                  Command="{Binding ToggleRuntimeCommand}" />
          <Button Width="38"
                  Height="38"
                  Padding="8"
                  Margin="0,0,18,0"
                  HorizontalAlignment="Right"
                  Background="Transparent"
                  Command="{Binding OpenAvailableUpdateCommand}"
                  Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVisibility}}"
                  ToolTipService.InitialShowDelay="250"
                  ToolTipService.ShowDuration="30000"
                  AutomationProperties.Name="{Binding UpdateTooltipTitle}">
            <Button.ToolTip>
              <ToolTip MaxWidth="290"
                       Padding="10"
                       Background="#242B31"
                       BorderBrush="#D9A93D"
                       BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="{Binding UpdateTooltipTitle}"
                             Foreground="{StaticResource WarningBrush}"
                             FontWeight="SemiBold"
                             FontSize="13" />
                  <TextBlock Text="{Binding UpdateTooltipDescription}"
                             Margin="0,6,0,0"
                             Foreground="{StaticResource TextBrush}"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding UpdateTooltipAction}"
                             Margin="0,7,0,0"
                             Foreground="{StaticResource MutedTextBrush}"
                             FontSize="11"
                             TextWrapping="Wrap" />
                </StackPanel>
              </ToolTip>
            </Button.ToolTip>
            <Viewbox Width="22"
                     Height="22"
                     Stretch="Uniform">
              <Path Width="24"
                    Height="24"
                    Data="M12,3 L12,15 M7,10 L12,15 L17,10 M5,20 L19,20"
                    Fill="Transparent"
                    Stroke="{StaticResource WarningBrush}"
                    StrokeThickness="2.1"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    Stretch="Uniform" />
            </Viewbox>
          </Button>
        </Grid>
      </Grid>

      <Grid Grid.RowSpan="2"
            Background="Transparent"
            Panel.ZIndex="10"
            MouseLeftButtonDown="HelpBackdrop_OnMouseLeftButtonDown"
            Visibility="{Binding IsHelpOpen, Converter={StaticResource BoolToVisibility}}">
        <Border Width="286"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,48,10,0"
                Padding="12"
                CornerRadius="14"
                Background="#242B31"
                BorderBrush="#364049"
                BorderThickness="1"
                MouseLeftButtonDown="HelpPanel_OnMouseLeftButtonDown">
          <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding AboutText}"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding VersionText}"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="11"
                       VerticalAlignment="Center" />
          </Grid>
          <TextBlock Text="{Binding AboutDescriptionText}"
                     Margin="0,6,0,0"
                     Foreground="{StaticResource MutedTextBrush}"
                     FontSize="11"
                     LineHeight="16"
                     TextWrapping="Wrap" />
          <Separator Margin="0,8" Background="#46515B" />
          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding LanguageText}"
                       Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="RU" Width="44" Padding="8,5" Command="{Binding SetRussianCommand}" />
              <Button Content="EN" Width="44" Padding="8,5" Margin="5,0,0,0" Command="{Binding SetEnglishCommand}" />
            </StackPanel>
          </Grid>
          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox Content="{Binding LogsText}"
                      Foreground="{StaticResource TextBrush}"
                      IsChecked="{Binding DetailedLogs}"
                      VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="{Binding ViewLogsText}"
                    Padding="9,5"
                    Click="OpenLogs_OnClick" />
          </Grid>
          <Button Command="{Binding OpenAuthorDiscordCommand}"
                  Padding="10,6"
                  HorizontalContentAlignment="Stretch">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Image Source="pack://application:,,,/KROT;component/assets/services/discord-512px.png"
                     Width="20"
                     Height="20"
                     Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock Grid.Column="1"
                         Text="{Binding AuthorDiscordText}"
                         VerticalAlignment="Center"
                         Margin="9,0,0,0" />
              <TextBlock Grid.Column="2"
                         Text="↗"
                         Margin="12,0,1,0"
                         Foreground="{StaticResource MutedTextBrush}"
                         FontSize="12"
                         VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button Command="{Binding OpenProjectRepositoryCommand}"
                  Margin="0,4,0,0"
                  Padding="10,6"
                  HorizontalContentAlignment="Stretch">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Image Source="pack://application:,,,/KROT;component/assets/services/github-dark-512px.png"
                     Width="20"
                     Height="20"
                     Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock Grid.Column="1"
                         Text="{Binding ProjectRepositoryText}"
                         VerticalAlignment="Center"
                         Margin="9,0,0,0" />
              <TextBlock Grid.Column="2"
                         Text="MIT"
                         Margin="12,0,0,0"
                         Foreground="{StaticResource MutedTextBrush}"
                         FontSize="11"
                         VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Grid Margin="0,4,0,0">
            <Button x:Name="LicensesButton"
                    Command="{Binding ToggleLicensesCommand}"
                    Padding="10,7"
                    HorizontalContentAlignment="Stretch">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding LicensesText}"
                           VerticalAlignment="Center" />
                <Path Grid.Column="1"
                      Width="10"
                      Height="6"
                      Margin="10,0,0,0"
                      Data="M 1,1 L 5,5 L 9,1"
                      Stroke="{StaticResource MutedTextBrush}"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      RenderTransformOrigin="0.5,0.5">
                  <Path.Style>
                    <Style TargetType="Path">
                      <Setter Property="RenderTransform">
                        <Setter.Value>
                          <RotateTransform Angle="0" />
                        </Setter.Value>
                      </Setter>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLicensesOpen}" Value="True">
                          <Setter Property="RenderTransform">
                            <Setter.Value>
                              <RotateTransform Angle="180" />
                            </Setter.Value>
                          </Setter>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Path.Style>
                </Path>
              </Grid>
            </Button>
            <Popup PlacementTarget="{Binding ElementName=LicensesButton}"
                   Placement="Bottom"
                   VerticalOffset="4"
                   DataContext="{Binding DataContext, ElementName=LicensesButton}"
                   IsOpen="{Binding IsLicensesOpen, Mode=TwoWay}"
                   StaysOpen="False"
                   AllowsTransparency="True">
              <Border Width="260"
                      Padding="6"
                      CornerRadius="12"
                      Background="#1D2329"
                      BorderBrush="#46515B"
                      BorderThickness="1">
                <Border.Effect>
                  <DropShadowEffect Color="#000000"
                                    BlurRadius="18"
                                    ShadowDepth="6"
                                    Opacity="0.42" />
                </Border.Effect>
                <StackPanel>
                  <Button Command="{Binding OpenZapretCommand}"
                          Padding="9,6"
                          HorizontalContentAlignment="Stretch">
                    <Grid>
                      <TextBlock Text="{Binding ZapretText}" />
                      <TextBlock Text="MIT"
                                 HorizontalAlignment="Right"
                                 Foreground="{StaticResource MutedTextBrush}"
                                 FontSize="11" />
                    </Grid>
                  </Button>
                  <Button Command="{Binding OpenTelegramProxyRepositoryCommand}"
                          Margin="0,2,0,0"
                          Padding="9,6"
                          HorizontalContentAlignment="Stretch">
                    <Grid>
                      <TextBlock Text="{Binding TelegramProxyRepositoryText}" />
                      <TextBlock Text="MIT"
                                 HorizontalAlignment="Right"
                                 Foreground="{StaticResource MutedTextBrush}"
                                 FontSize="11" />
                    </Grid>
                  </Button>
                  <Button Command="{Binding OpenWinDivertCommand}"
                          Margin="0,2,0,0"
                          Padding="9,6"
                          HorizontalContentAlignment="Stretch">
                    <Grid>
                      <TextBlock Text="{Binding WinDivertText}" />
                      <TextBlock Text="LGPL-3.0"
                                 HorizontalAlignment="Right"
                                 Foreground="{StaticResource MutedTextBrush}"
                                 FontSize="11" />
                    </Grid>
                  </Button>
                  <Separator Margin="4,5" Background="#46515B" />
                  <Button Command="{Binding OpenThirdPartyNoticesCommand}"
                          Padding="9,6"
                          HorizontalContentAlignment="Left">
                    <TextBlock Text="{Binding AllLicensesText}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11" />
                  </Button>
                </StackPanel>
              </Border>
            </Popup>
          </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
