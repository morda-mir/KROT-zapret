<Window x:Class="KROT.App.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KROT logs"
        Width="760"
        Height="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
      <Button x:Name="RefreshButton" Content="Обновить" Click="Refresh_OnClick" />
      <Button x:Name="CopyButton" Content="Копировать" Margin="8,0,0,0" Click="Copy_OnClick" />
      <Button x:Name="OpenFolderButton" Content="Открыть папку" Margin="8,0,0,0" Click="OpenFolder_OnClick" />
      <Button x:Name="ClearOldButton" Content="Очистить старые" Margin="8,0,0,0" Click="ClearOld_OnClick" />
    </StackPanel>
    <TextBox x:Name="LogText"
             Grid.Row="1"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="NoWrap"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto"
             Background="#0E1114"
             Foreground="#C8D0D6"
             BorderBrush="#303840"
             FontFamily="Consolas"
             FontSize="12" />
  </Grid>
</Window>
